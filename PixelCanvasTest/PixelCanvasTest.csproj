<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('Windows'))">net481;$(TargetFrameworks)</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <!-- xUnit v3 builds test projects as executables. On .NET Framework the SDK would then default to
         a 32-bit runtime identifier, and the 64-bit native libraries would fail to load. -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <RootNamespace>Codecrete.SwissQRBill.PixelCanvasTest</RootNamespace>
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
    <TestResultsFile>$([System.IO.Path]::Combine($(MSBuildThisFileDirectory),'..','TestResults-$(MSBuildProjectName)-$(TargetFramework).html'))</TestResultsFile>
  </PropertyGroup>

  <ItemGroup>
    <VSTestLogger Include="html%3BLogFileName=$([System.IO.Path]::GetFullPath($(TestResultsFile)))" Visible="false" />
  </ItemGroup>

  <PropertyGroup>
    <VSTestLogger>@(VSTestLogger)</VSTestLogger>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      NuGet audit reports known ImageMagick vulnerabilities for the pinned Magick.NET version (see below).
      They concern the decoding of untrusted input. These test projects only ever process images they have
      generated themselves, so the advisories do not apply here.
    -->
    <NoWarn>$(NoWarn);NU1901;NU1902;NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned: ImageMagick 7.1.2-3 and later (Magick.NET 14.14.0+) have lost the sensitivity of the
         perceptual hash. Two entirely different QR bills then compare as equal, which would make the
         image comparison silently accept any change. See ImageComparer.cs. -->
    <PackageReference Include="Magick.NET-Q16-AnyCPU" Version="14.13.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.0" />
    <PackageReference Include="Verify.XunitV3" Version="31.28.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\TestShared\ImageComparer.cs" Link="ImageComparer.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PixelCanvas\PixelCanvas.csproj" />
  </ItemGroup>

</Project>
